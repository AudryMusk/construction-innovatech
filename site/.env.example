# Copiez ce fichier vers .env.local pour travailler en local.
# En production, ajoutez ces trois variables dans les réglages de l’hébergeur.

# Clé API créée dans https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d’expédition sur un domaine vérifié dans Resend.
RESEND_FROM_EMAIL=Construction Innovatech <soumissions@constructioninnovatech.com>

# Adresse qui reçoit les nouvelles demandes.
CONTACT_EMAIL=info@constructioninnovatech.com
